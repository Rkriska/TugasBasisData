@article{maupinNetworkbasedApproachesLeadership2024,
  title = {Network-Based Approaches to Leadership: {{An}} Organizing Framework, Review, and Recommendations},
  shorttitle = {Network-Based Approaches to Leadership},
  author = {Maupin, Cynthia K. and Mohan, Gouri and Choudhury, Anwesha and Deepak, Pratibha and Jin, Fuhe},
  year = {2024},
