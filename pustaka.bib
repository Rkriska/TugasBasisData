@article{quijanoSustainableSmartCities2022,
  title = {Towards {{Sustainable}} and {{Smart Cities}}: {{Replicable}} and {{KPI-Driven Evaluation Framework}}},
  shorttitle = {Towards {{Sustainable}} and {{Smart Cities}}},
  author = {Quijano, Ana and Hern{\'a}ndez, Jose L. and Nouaille, Pierre and Virtanen, Mikko and {S{\'a}nchez-Sarachu}, Beatriz and {Pardo-Bosch}, Francesc and Knieilng, J{\"o}rg},
  year = {2022},
