@article{faisalDevelopmentReadinessModel2024,
  title = {Development of a Readiness Model for Industry 4.0 Using {{Analytical Hierarchy}} Process and Fuzzy Inference System: {{Bangladesh}} Perspective},
  shorttitle = {Development of a Readiness Model for Industry 4.0 Using {{Analytical Hierarchy}} Process and Fuzzy Inference System},
