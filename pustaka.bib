@article{universityofmunsterAttentionDigitalInnovation2023,
  title = {Attention to {{Digital Innovation}}: {{Exploring}} the {{Impact}} of a {{Chief Information Officer}} in the {{Top Management Team}}},
  shorttitle = {Attention to {{Digital Innovation}}},
  author = {{University of M{\"u}nster} and Bendig, David and Wagner, Robin and {University of M{\"u}nster} and Piening, Erk and {Leibniz University Hannover} and Nils Foege, Johann and {Leibniz University Hannover}},
